# Optional overrides for `docker compose up` at the repo root.
# Copy to .env and fill in only what you need — the stack runs without any of it.

# Real AI scoring. Without it, every submission scores a fixed placeholder 6.
OPENAI_API_KEY=

# Signs the login JWTs. Change it for anything but local testing.
JWT_SECRET=dev-only-insecure-secret

# Real verification emails. Without these, the 6-digit OTP is printed to the
# API logs (`docker compose logs api`), which is usually what you want locally.
# For Gmail: enable 2-Step Verification, then create an App Password for "Mail"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SceneScribe <your-email@gmail.com>"

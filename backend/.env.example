DATABASE_URL=postgres://postgres:password@localhost:5432/scenescribe
OPENAI_API_KEY=

# Signs login JWTs. Required — jwt.sign() throws if this is unset.
JWT_SECRET=dev-only-insecure-secret

# ── Email / OTP ────────────────────────────────────────────────────────────────
# If these are left blank the server logs the OTP to the console instead of
# sending a real email (useful for local development and testing).
# For Gmail:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Use that 16-character password as SMTP_PASS (no spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="SceneScribe <your-email@gmail.com>"


# Postgres SSL. Auto-detected from DATABASE_URL (off for localhost/db, on for
# hosted databases). Set true/false only to override that.
# DATABASE_SSL=
